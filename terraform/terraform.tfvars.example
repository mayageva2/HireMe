aws_region = "us-east-1"

# Leave empty to use environment credentials (AWS Academy lab session).
# Set a name only if you keep a named profile in ~/.aws/credentials.
aws_profile = ""

project_name = "hireme"
environment  = "lab"

# Normal AWS account: Terraform creates the Lambda role. Hosting matches the
# lab: Amplify serves the React app and rewrites /api/* to API Gateway.
create_lambda_role = true
enable_amplify     = true
enable_cloudfront  = false

# Agent bootstrap: apply with count 0, populate its Secrets Manager JSON,
# push the Docker image, then change desired_count to 1 and apply again.
enable_agent        = true
agent_desired_count = 0
agent_image_tag     = "latest"

# Public Simli face UUIDs. Terraform writes these onto the ECS task.
# Paste the lab HR face from: ECS → hireme-agent task definition → SIMLI_FACE_ID.
hr_simli_face_id        = "replace-with-lab-hr-simli-face-id"
technical_simli_face_id = "dd10cb5a-d31d-4f12-b69f-6db3383c006e"

# Leave true in a normal account. Set false to reuse an existing VPC/subnets.
agent_create_network      = true
agent_existing_vpc_id     = null
agent_existing_subnet_ids = []

# Set connect_github = true with a token to let Terraform attach the repo and
# create the branch. Otherwise connect the repo in the Amplify console.
connect_github               = false
github_repository            = "https://github.com/MayaandMayOrganization/HireMe"
github_access_token          = ""
amplify_branch_name          = "may-dev"
amplify_iam_service_role_arn = ""

# AWS Academy: IAM role creation is blocked. Use:
#   create_lambda_role = false
academy_role_name = "LabRole"
lambda_role_arn   = null

livekit_url        = "wss://your-project.livekit.cloud"
livekit_api_key    = "replace-me"
livekit_api_secret = "replace-me"

# Optional: leave empty to use the CV service's mock fallback.
openai_api_key = ""
openai_model   = "gpt-4.1-mini"
