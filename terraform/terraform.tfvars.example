aws_region  = "us-east-1"
aws_profile = "default"

project_name = "hireme"
environment  = "lab"

# Normal AWS account: Terraform creates the Lambda role and CloudFront so
# /api/* works the same way Amplify rewrites work in the lab.
create_lambda_role = true
enable_cloudfront  = true

# AWS Academy: IAM role creation and CloudFront are blocked. Use:
#   create_lambda_role = false
#   enable_cloudfront  = false
academy_role_name = "LabRole"
lambda_role_arn   = null

livekit_url        = "wss://your-project.livekit.cloud"
livekit_api_key    = "replace-me"
livekit_api_secret = "replace-me"

# Optional: leave empty to use the CV service's mock fallback.
openai_api_key = ""
openai_model   = "gpt-4.1-mini"
