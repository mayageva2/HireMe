aws_region  = "us-east-1"
aws_profile = "default"

project_name = "hireme"
environment  = "lab"

# Normal AWS account: Terraform creates the Lambda role. Hosting matches the
# lab: Amplify serves the React app and rewrites /api/* to API Gateway.
create_lambda_role = true
enable_amplify     = true
enable_cloudfront  = false

# Connect Git so Amplify can auto-build. Leave the token empty to create the
# Amplify app first and attach the GitHub repo in the AWS console.
github_repository    = "https://github.com/MayaandMayOrganization/HireMe"
github_access_token  = ""
amplify_branch_name  = "may-dev"

# AWS Academy: IAM role creation is blocked. Use:
#   create_lambda_role = false
academy_role_name = "LabRole"
lambda_role_arn   = null

livekit_url        = "wss://your-project.livekit.cloud"
livekit_api_key    = "replace-me"
livekit_api_secret = "replace-me"

# Optional: leave empty to use the CV service's mock fallback.
openai_api_key = ""
openai_model   = "gpt-4.1-mini"
